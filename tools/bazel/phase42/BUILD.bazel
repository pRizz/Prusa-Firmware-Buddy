load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load(":arm_link_smoke.bzl", "arm_link_smoke")
load(":platform_contract.bzl", "PHASE42_MINI_CONSTRAINTS")

package(default_visibility = ["//visibility:private"])

constraint_value(
    name = "thumbv7em_none_eabi",
    constraint_setting = "//platforms:rust_target",
)

constraint_value(
    name = "wrong_triple",
    constraint_setting = "//platforms:rust_target",
)

platform(
    name = "wrong_printer_platform",
    constraint_values = [
        "//platforms:runtime_embedded",
        "//platforms:printer_mk4",
        "//platforms:board_buddy",
        "//platforms:mcu_stm32f407vg",
        "//platforms:thumbv7em_none_eabihf",
    ],
)

platform(
    name = "wrong_board_platform",
    constraint_values = [
        "//platforms:runtime_embedded",
        "//platforms:printer_mini",
        "//platforms:board_xbuddy",
        "//platforms:mcu_stm32f407vg",
        "//platforms:thumbv7em_none_eabihf",
    ],
)

platform(
    name = "wrong_mcu_platform",
    constraint_values = [
        "//platforms:runtime_embedded",
        "//platforms:printer_mini",
        "//platforms:board_buddy",
        "//platforms:mcu_stm32f427zi",
        "//platforms:thumbv7em_none_eabihf",
    ],
)

platform(
    name = "wrong_triple_platform",
    constraint_values = [
        "//platforms:runtime_embedded",
        "//platforms:printer_mini",
        "//platforms:board_buddy",
        "//platforms:mcu_stm32f407vg",
        ":wrong_triple",
    ],
)

platform(
    name = "soft_float_platform",
    constraint_values = [
        "//platforms:runtime_embedded",
        "//platforms:printer_mini",
        "//platforms:board_buddy",
        "//platforms:mcu_stm32f407vg",
        ":thumbv7em_none_eabi",
    ],
)

config_setting(
    name = "rust_capability_available",
    define_values = {"phase42_rust_capability": "available"},
)

config_setting(
    name = "arm_capability_available",
    define_values = {"phase42_arm_capability": "available"},
)

config_setting(
    name = "python_capability_available",
    define_values = {"phase42_python_capability": "available"},
)

config_setting(
    name = "mini404_capability_available",
    define_values = {"phase42_mini404_capability": "available"},
)

genrule(
    name = "missing_rust_capability",
    outs = ["missing_rust_capability.txt"],
    cmd = select(
        {":rust_capability_available": "touch $@"},
        no_match_error = "Phase 42 missing Rust capability: Plan 42-01 owns declared Rust 1.85.0 resolution; use the canonical Linux x86_64 MINI toolchain",
    ),
    target_compatible_with = PHASE42_MINI_CONSTRAINTS,
)

genrule(
    name = "missing_arm_capability",
    outs = ["missing_arm_capability.txt"],
    cmd = select(
        {":arm_capability_available": "touch $@"},
        no_match_error = "Phase 42 missing Arm capability: Plan 42-01 owns declared Arm GNU 13.2.Rel1 resolution; use the canonical Linux x86_64 MINI toolchain",
    ),
    target_compatible_with = PHASE42_MINI_CONSTRAINTS,
)

genrule(
    name = "missing_python_capability",
    outs = ["missing_python_capability.txt"],
    cmd = select(
        {":python_capability_available": "touch $@"},
        no_match_error = "Phase 42 missing Python capability: Plan 42-01 owns rules_python Python 3.12.10 resolution; use the canonical Linux x86_64 MINI toolchain",
    ),
    target_compatible_with = PHASE42_MINI_CONSTRAINTS,
)

genrule(
    name = "missing_mini404_capability",
    outs = ["missing_mini404_capability.txt"],
    cmd = select(
        {":mini404_capability_available": "touch $@"},
        no_match_error = "Phase 42 missing Mini404 capability: Plan 42-01 owns declared Mini404 0.9.10 resolution; use the canonical Linux x86_64 MINI toolchain",
    ),
    target_compatible_with = PHASE42_MINI_CONSTRAINTS,
)

py_library(
    name = "phase42_test_support",
    srcs = ["phase42_test_support.py"],
    imports = ["."],
)

arm_link_smoke(
    name = "arm_link_smoke",
    src = "arm_link_smoke.rs",
    linker_script = "arm_link_smoke.ld",
    target_compatible_with = PHASE42_MINI_CONSTRAINTS,
)

py_test(
    name = "toolchain_provenance_tests",
    srcs = ["toolchain_provenance_test.py"],
    legacy_create_init = 0,
    main = "toolchain_provenance_test.py",
    python_version = "PY3",
)

py_test(
    name = "embedded_toolchain_contract_tests",
    srcs = ["embedded_toolchain_contract_test.py"],
    legacy_create_init = 0,
    main = "embedded_toolchain_contract_test.py",
    python_version = "PY3",
)

py_test(
    name = "host_policy_contract_tests",
    srcs = ["host_policy_contract_test.py"],
    legacy_create_init = 0,
    main = "host_policy_contract_test.py",
    python_version = "PY3",
)

py_test(
    name = "arm_link_smoke_tests",
    srcs = ["arm_link_smoke_test.py"],
    legacy_create_init = 0,
    main = "arm_link_smoke_test.py",
    python_version = "PY3",
)

py_test(
    name = "platform_rejection_tests",
    srcs = ["platform_rejection_test.py"],
    legacy_create_init = 0,
    main = "platform_rejection_test.py",
    python_version = "PY3",
    deps = [":phase42_test_support"],
)

py_test(
    name = "graph_isolation_tests",
    srcs = ["graph_isolation_test.py"],
    legacy_create_init = 0,
    main = "graph_isolation_test.py",
    python_version = "PY3",
    deps = [":phase42_test_support"],
)

py_test(
    name = "facade_contract_tests",
    srcs = ["facade_contract_test.py"],
    env = {"PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"},
    legacy_create_init = 0,
    main = "facade_contract_test.py",
    python_version = "PY3",
    deps = [":phase42_test_support"],
)
